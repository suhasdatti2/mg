<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__content reveal">
      <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hero__title">{{ section.settings.headline }} <span class="accent">{{ section.settings.headline_accent }}</span></h1>
      <p class="hero__sub">{{ section.settings.subheadline }}</p>
      <div class="hero__ctas">
        <a href="#product" class="btn btn--lime btn--lg">{{ section.settings.cta_primary }}</a>
        <a href="#how-it-works" class="btn btn--ghost">{{ section.settings.cta_secondary }}</a>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <div class="hero__stat-num">99</div>
          <div class="hero__stat-label">Speed Levels</div>
        </div>
        <div class="hero__stat">
          <div class="hero__stat-num">4.9★</div>
          <div class="hero__stat-label">Rating</div>
        </div>
        <div class="hero__stat">
          <div class="hero__stat-num">2847</div>
          <div class="hero__stat-label">Customers</div>
        </div>
      </div>
    </div>

    <div class="hero__media reveal">
      {% render 'placeholder-image', src: section.settings.image | image_url: width: 1200, alt: 'RECVR Pro massage gun', class: 'hero__img' %}
      <div class="hero__badge">44% OFF<br>TODAY</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Percussion Recovery — Reinvented" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Melt away" },
    { "type": "text", "id": "headline_accent", "label": "Headline accent word", "default": "soreness." },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Pro-grade percussion therapy in a near-silent, 1.2lb device. Loosen tight muscles, ease tension, and recover faster — wherever you are." },
    { "type": "text", "id": "cta_primary", "label": "Primary CTA", "default": "Buy Now — $49.99" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary CTA", "default": "See how it works →" },
    { "type": "image_picker", "id": "image", "label": "Product image" }
  ]
}
{% endschema %}
