<section class="section product" id="product">
  <div class="wrap product__grid">
    <!-- Media gallery -->
    <div class="product__media reveal">
      <div class="product__main">
        {% render 'product-photo',
          image: section.settings.image_1,
          file: section.settings.file_1,
          id: 'ProdMain',
          class: 'product__main-img2',
          alt: 'Novora World Cup jersey',
          loading: 'eager' %}
        {%- if section.settings.cap_1 != blank -%}
          <span class="product__caption" id="ProdCaption">{{ section.settings.cap_1 }}</span>
        {%- endif -%}
      </div>
      <div class="product__thumbs-wrap">
        <button class="product__thumb-arrow product__thumb-arrow--prev" data-thumb-prev aria-label="Previous" hidden>
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 5 7 9 3"/></svg>
        </button>
        <div class="product__thumbs" data-thumbs-strip>
          {%- assign caps = section.settings.cap_1 | append: '|' | append: section.settings.cap_2 | append: '|' | append: section.settings.cap_3 | append: '|' | append: section.settings.cap_4 | append: '|' | append: section.settings.cap_5 | append: '|' | append: section.settings.cap_6 | split: '|' -%}
          {%- assign files = section.settings.file_1 | append: '|' | append: section.settings.file_2 | append: '|' | append: section.settings.file_3 | append: '|' | append: section.settings.file_4 | append: '|' | append: section.settings.file_5 | append: '|' | append: section.settings.file_6 | split: '|' -%}
          {%- for n in (1..6) -%}
            {%- assign key = 'image_' | append: n -%}
            {%- assign img = section.settings[key] -%}
            {%- assign cap = caps[forloop.index0] -%}
            {%- assign file = files[forloop.index0] -%}
            {%- if img != blank -%}{%- assign src = img | image_url: width: 1400 -%}{%- else -%}{%- assign src = file | asset_url -%}{%- endif -%}
            <button class="product__thumb {% if forloop.first %}is-active{% endif %}" data-thumb
              data-img="{{ src }}"
              data-cap="{{ cap | escape }}"
              aria-label="View {{ n }}">
              {% render 'product-photo', image: img, file: file, alt: cap %}
            </button>
          {%- endfor -%}
        </div>
        <button class="product__thumb-arrow product__thumb-arrow--next" data-thumb-next aria-label="Next">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 3 9 7 5 11"/></svg>
        </button>
      </div>
    </div>

    <!-- Details -->
    <div class="product__details reveal">
      <p class="product__label">NOVORA · OFFICIAL FAN KIT</p>
      <h1 class="product__title">Novora World Cup Jersey</h1>

      <div class="product__rating">
        <span class="product__stars">★★★★★</span>
        <span class="product__rating-count">4.9 · 2,431 reviews</span>
      </div>

      <div class="product__price">
        <span class="product__price-now">$34.99</span>
        <span class="product__price-was">$69.99</span>
        <span class="product__save">SAVE 50%</span>
      </div>

      <div class="product__select">
        <p class="product__label" style="margin-bottom:10px">Nation — <span data-swatch-label>Argentina</span></p>
        <div class="product__swatches" data-swatches role="radiogroup" aria-label="Nation">
          <button class="swatch is-active" data-swatch="Argentina" data-thumb-target="0" style="background:linear-gradient(180deg,#75AADB 50%,#fff 50%)" aria-checked="true"  aria-label="Argentina"></button>
          <button class="swatch"           data-swatch="France"    data-thumb-target="1" style="background:#1A2A6C"                                     aria-checked="false" aria-label="France"></button>
          <button class="swatch"           data-swatch="Portugal"  data-thumb-target="2" style="background:#C8102E"                                     aria-checked="false" aria-label="Portugal"></button>
          <button class="swatch"           data-swatch="Brazil"    data-thumb-target="3" style="background:#FEDD00"                                     aria-checked="false" aria-label="Brazil"></button>
          <button class="swatch"           data-swatch="England"   data-thumb-target="4" style="background:#fff;border-color:#bbb"                                            aria-checked="false" aria-label="England"></button>
          <button class="swatch"           data-swatch="Spain"     data-thumb-target="5" style="background:linear-gradient(180deg,#C60B1E 50%,#FFC400 50%)"                   aria-checked="false" aria-label="Spain"></button>
        </div>
      </div>

      <div class="product__select">
        <p class="product__label" style="margin-bottom:10px">Size — <span data-swatch-label>M</span></p>
        <div class="product__sizes" data-swatches role="radiogroup" aria-label="Size">
          <button class="size-opt" data-swatch="S" aria-checked="false">S</button>
          <button class="size-opt is-active" data-swatch="M" aria-checked="true">M</button>
          <button class="size-opt" data-swatch="L" aria-checked="false">L</button>
          <button class="size-opt" data-swatch="XL" aria-checked="false">XL</button>
          <button class="size-opt" data-swatch="XXL" aria-checked="false">XXL</button>
        </div>
      </div>

      <div class="product__buttons">
        <button class="btn btn--dark btn--block btn--lg" data-add-to-cart>Add to Cart</button>
        <a href="/checkout" class="btn btn--outline btn--block btn--lg">Buy Now</a>
      </div>

      <div class="product__trust">
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Free Worldwide Shipping
        </span>
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          30-Day Returns
        </span>
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
          Authentic Quality
        </span>
      </div>

      <div class="attach">
        <div class="attach__head">
          <span class="attach__title">Most-wanted nations</span>
          <span class="attach__note">All 32 available</span>
        </div>
        <div class="attach__grid attach__grid--nations">
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#75AADB 50%,#fff 50%)"></span><span class="attach__lbl">Argentina</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:#FEDD00"></span><span class="attach__lbl">Brazil</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:#1A2A6C"></span><span class="attach__lbl">France</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:#C8102E"></span><span class="attach__lbl">Portugal</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:#fff;border:1px solid #ccc"></span><span class="attach__lbl">England</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#C60B1E 50%,#FFC400 50%)"></span><span class="attach__lbl">Spain</span></div>
        </div>
      </div>

      <div class="accordion" data-accordion>
        {% for block in section.blocks %}
          <div class="accordion__item" data-accordion-item {{ block.shopify_attributes }}>
            <button class="accordion__trigger" data-accordion-trigger aria-expanded="false">
              {{ block.settings.title }}
              <span class="accordion__icon" aria-hidden="true"></span>
            </button>
            <div class="accordion__panel" data-accordion-panel>
              <div class="accordion__panel-inner">{{ block.settings.content }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Gallery photos — Assets files (easiest)" },
    { "type": "paragraph", "content": "Upload your photos via Edit code → Assets, then enter the exact filenames below (e.g. jersey-1.jpg)." },
    { "type": "text", "id": "file_1", "label": "File 1 — Argentina (main)", "default": "jersey-1.jpg" },
    { "type": "text", "id": "file_2", "label": "File 2 — France", "default": "jersey-2.jpg" },
    { "type": "text", "id": "file_3", "label": "File 3 — Portugal", "default": "jersey-3.jpg" },
    { "type": "text", "id": "file_4", "label": "File 4 — Brazil", "default": "jersey-4.jpg" },
    { "type": "text", "id": "file_5", "label": "File 5 — England", "default": "jersey-5.jpg" },
    { "type": "text", "id": "file_6", "label": "File 6 — Spain", "default": "jersey-6.jpg" },
    { "type": "header", "content": "Gallery photos — image picker (optional override)" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (main)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" },
    { "type": "header", "content": "Slide captions" },
    { "type": "text", "id": "cap_1", "label": "Caption 1", "default": "Stadium-grade heavyweight knit" },
    { "type": "text", "id": "cap_2", "label": "Caption 2", "default": "Crisp heat-pressed badges" },
    { "type": "text", "id": "cap_3", "label": "Caption 3", "default": "Breathable quick-dry mesh" },
    { "type": "text", "id": "cap_4", "label": "Caption 4", "default": "Add your name & number free" },
    { "type": "text", "id": "cap_5", "label": "Caption 5", "default": "Classic three lions home kit" },
    { "type": "text", "id": "cap_6", "label": "Caption 6", "default": "La Roja official colors" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Sizing & fit", "content": "True to size with a standard athletic cut. S (chest 36\"), M (40\"), L (44\"), XL (48\"), XXL (52\"). Between sizes? Size up for a relaxed fan fit." } },
        { "type": "accordion", "settings": { "title": "Shipping & delivery", "content": "Free tracked worldwide shipping. Orders dispatch within 48 hours; delivery typically 7–12 business days depending on your country." } },
        { "type": "accordion", "settings": { "title": "Material & care", "content": "100% breathable quick-dry polyester knit with heat-pressed crests. Machine wash cold, inside out, and hang dry to keep colors vivid." } },
        { "type": "accordion", "settings": { "title": "Returns", "content": "Not the right fit? Return within 30 days for a free exchange or full refund. Personalized jerseys are final sale." } }
      ]
    }
  ]
}
{% endschema %}
