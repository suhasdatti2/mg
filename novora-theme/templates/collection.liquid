{% paginate collection.products by 12 %}
<div class="page-shell">
  <div class="wrap">
    <h1 class="page__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="page__content rte">{{ collection.description }}</div>
    {%- endif -%}

    <div class="product-grid">
      {%- for product in collection.products -%}
        <a href="{{ product.url }}" class="product-card">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}">
          {%- endif -%}
          <p class="product-card__title">{{ product.title }}</p>
          <p class="product-card__price">{{ product.price | money }}</p>
        </a>
      {%- else -%}
        <p>No products in this collection yet.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  </div>
</div>
{% endpaginate %}
