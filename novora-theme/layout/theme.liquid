<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <script>
      document.documentElement.className += ' js';
      // Safety net: if theme.js fails to run, reveal everything anyway.
      window.addEventListener('load', function () {
        setTimeout(function () {
          if (!window.__novoraReady) {
            var els = document.querySelectorAll('.reveal');
            for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
          }
        }, 500);
      });
    </script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="#1C1A17">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- comment -%} Google Fonts: Playfair Display (serif headlines) + Inter (body) {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --color-primary: {{ settings.color_primary | default: '#1C1A17' }};
        --color-accent: {{ settings.color_accent | default: '#9B2C2C' }};
        --color-bg: {{ settings.color_bg | default: '#F4EFE7' }};
        --color-text: {{ settings.color_text | default: '#211C15' }};
      }
    </style>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content" href="#MainContent">Skip to content</a>
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
