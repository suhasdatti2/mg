<div class="announcement">
  {{ section.settings.text }}
  {%- if section.settings.link_text != blank -%}
    <a href="{{ section.settings.link | default: '#product' }}">{{ section.settings.link_text }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Flash Sale — 44% OFF Today Only | Free US Shipping |"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop Now →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
