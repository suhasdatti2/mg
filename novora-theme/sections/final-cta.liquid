<section class="section final">
  <div class="wrap final__inner reveal">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="final__title">{{ section.settings.headline }} <span class="accent">{{ section.settings.headline_accent }}</span></h2>
    <p class="final__sub">{{ section.settings.subtext }}</p>
    <a href="#product" class="btn btn--lime btn--lg">{{ section.settings.cta }}</a>
    <p class="final__urgency">{{ section.settings.urgency }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wear the world's game" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Represent your" },
    { "type": "text", "id": "headline_accent", "label": "Headline accent", "default": "nation." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Join 12,000+ fans repping their colors. Stadium-grade World Cup jerseys, fully customizable, now up to 50% off." },
    { "type": "text", "id": "cta", "label": "CTA", "default": "Shop Jerseys — $34.99" },
    { "type": "text", "id": "urgency", "label": "Urgency line", "default": "World Cup drop selling fast · Free worldwide shipping · Ships in 48hrs" }
  ]
}
{% endschema %}
