{%- comment -%}
  Floating animated SVG paths — ported from the BackgroundPaths React component.
  Param: position (1 or -1) controls the horizontal sweep direction.
  Paths use the same generation formula as the original; motion is driven by
  CSS (stroke-dashoffset flow + opacity pulse) instead of framer-motion.
{%- endcomment -%}
<svg class="fpaths" viewBox="0 0 696 316" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {%- for i in (0..35) -%}
    {%- assign off = i | times: 5 | times: position -%}
    {%- assign a = 380 | minus: off -%}
    {%- assign c = 312 | minus: off -%}
    {%- assign e = 152 | minus: off -%}
    {%- assign g = 616 | minus: off -%}
    {%- assign k = 684 | minus: off -%}
    {%- assign i6 = i | times: 6 -%}
    {%- assign b = i6 | plus: 189 -%}
    {%- assign d = 216 | minus: i6 -%}
    {%- assign f = 343 | minus: i6 -%}
    {%- assign h = 470 | minus: i6 -%}
    {%- assign l = 875 | minus: i6 -%}
    {%- assign wi = i | times: 3 | plus: 50 -%}
    {%- assign oi = i | times: 3 | plus: 10 -%}
    {%- assign dur = i | modulo: 6 | plus: 18 -%}
    <path
      d="M-{{ a }} -{{ b }}C-{{ a }} -{{ b }} -{{ c }} {{ d }} {{ e }} {{ f }}C{{ g }} {{ h }} {{ k }} {{ l }} {{ k }} {{ l }}"
      stroke="currentColor"
      stroke-width="{{ wi | divided_by: 100.0 }}"
      style="--fp-dur:{{ dur }}s;--fp-delay:-{{ i }}s;opacity:{{ oi | divided_by: 100.0 }}"
    />
  {%- endfor -%}
</svg>
