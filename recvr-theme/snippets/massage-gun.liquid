{%- comment -%}
  RECVR™ Pro percussion massage gun — inline SVG illustration.
  Colors are driven by CSS custom properties (--gun-1 main body, --gun-2
  darker parts) set on a parent .gun-stage, so the same markup can be
  recoloured live for each variant. Lime power button is fixed.
  Params: class (extra classes on the svg)
{%- endcomment -%}
<svg class="gun {{ class }}" viewBox="0 0 260 340" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="RECVR Pro massage gun">
  <!-- grip -->
  <rect class="gun-body" x="104" y="146" width="52" height="154" rx="26"/>
  <!-- grip front highlight -->
  <rect class="gun-hi" x="111" y="162" width="9" height="122" rx="4.5"/>
  <!-- motor housing -->
  <rect class="gun-body" x="60" y="90" width="140" height="84" rx="38"/>
  <!-- housing top highlight -->
  <ellipse class="gun-hi" cx="120" cy="104" rx="50" ry="11"/>
  <!-- housing right shade -->
  <rect class="gun-sh" x="178" y="100" width="16" height="68" rx="8"/>
  <!-- head arm -->
  <rect class="gun-body" x="110" y="34" width="40" height="84" rx="19"/>
  <!-- head outer ring -->
  <circle class="gun-dark" cx="130" cy="40" r="37"/>
  <!-- head cushion -->
  <circle class="gun-body" cx="130" cy="40" r="24"/>
  <!-- cushion bore -->
  <circle class="gun-dark" cx="130" cy="40" r="11"/>
  <!-- power button -->
  <circle class="gun-accent" cx="86" cy="126" r="8"/>
  <!-- speed indicator LEDs -->
  <rect class="gun-led" x="150" y="116" width="22" height="5" rx="2.5"/>
  <rect class="gun-led" x="150" y="126" width="22" height="5" rx="2.5"/>
  <rect class="gun-led" x="150" y="136" width="14" height="5" rx="2.5" opacity="0.5"/>
</svg>
