<div class="announcement">
  {{ section.settings.text }}
  {%- if section.settings.link_text != blank -%}
    <a href="{{ section.settings.link | default: '/#product' }}">{{ section.settings.link_text }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "2026 World Cup jerseys from $24.99 · 16 nations + custom available"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
