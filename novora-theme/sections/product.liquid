<section class="section product" id="product">
  <div class="wrap product__grid">
    <!-- Media gallery -->
    <div class="product__media reveal">
      <div class="product__main">
        {% render 'product-photo',
          image: section.settings.image_1,
          file: section.settings.file_1,
          id: 'ProdMain',
          class: 'product__main-img2',
          alt: 'Novora World Cup jersey',
          loading: 'eager' %}
        {%- if section.settings.cap_1 != blank -%}
          <span class="product__caption" id="ProdCaption">{{ section.settings.cap_1 }}</span>
        {%- endif -%}
      </div>
      <div class="product__thumbs-wrap">
        <button class="product__thumb-arrow product__thumb-arrow--prev" data-thumb-prev aria-label="Previous" hidden>
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 5 7 9 3"/></svg>
        </button>
        <div class="product__thumbs" data-thumbs-strip>
          {%- assign caps = section.settings.cap_1 | append: '|' | append: section.settings.cap_2 | append: '|' | append: section.settings.cap_3 | append: '|' | append: section.settings.cap_4 | append: '|' | append: section.settings.cap_5 | append: '|' | append: section.settings.cap_6 | append: '|' | append: section.settings.cap_7 | append: '|' | append: section.settings.cap_8 | append: '|' | append: section.settings.cap_9 | append: '|' | append: section.settings.cap_10 | append: '|' | append: section.settings.cap_11 | append: '|' | append: section.settings.cap_12 | append: '|' | append: section.settings.cap_13 | append: '|' | append: section.settings.cap_14 | append: '|' | append: section.settings.cap_15 | append: '|' | append: section.settings.cap_16 | split: '|' -%}
          {%- assign files = section.settings.file_1 | append: '|' | append: section.settings.file_2 | append: '|' | append: section.settings.file_3 | append: '|' | append: section.settings.file_4 | append: '|' | append: section.settings.file_5 | append: '|' | append: section.settings.file_6 | append: '|' | append: section.settings.file_7 | append: '|' | append: section.settings.file_8 | append: '|' | append: section.settings.file_9 | append: '|' | append: section.settings.file_10 | append: '|' | append: section.settings.file_11 | append: '|' | append: section.settings.file_12 | append: '|' | append: section.settings.file_13 | append: '|' | append: section.settings.file_14 | append: '|' | append: section.settings.file_15 | append: '|' | append: section.settings.file_16 | split: '|' -%}
          {%- for n in (1..16) -%}
            {%- assign key = 'image_' | append: n -%}
            {%- assign img = section.settings[key] -%}
            {%- assign cap = caps[forloop.index0] -%}
            {%- assign file = files[forloop.index0] -%}
            {%- if img != blank -%}{%- assign src = img | image_url: width: 1400 -%}{%- else -%}{%- assign src = file | asset_url -%}{%- endif -%}
            <button class="product__thumb {% if forloop.first %}is-active{% endif %}" data-thumb
              data-img="{{ src }}"
              data-cap="{{ cap | escape }}"
              aria-label="View {{ n }}">
              {% render 'product-photo', image: img, file: file, alt: cap %}
            </button>
          {%- endfor -%}
        </div>
        <button class="product__thumb-arrow product__thumb-arrow--next" data-thumb-next aria-label="Next">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 3 9 7 5 11"/></svg>
        </button>
      </div>
    </div>

    <!-- Details -->
    <div class="product__details reveal">
      <p class="product__label">NOVORA · OFFICIAL FAN KIT</p>
      <h1 class="product__title">Novora World Cup Jersey</h1>

      <div class="product__rating">
        <span class="product__stars">★★★★★</span>
        <span class="product__rating-count">4.9 · 2,431 reviews</span>
      </div>

      <div class="product__price">
        <span class="product__price-now">$34.99</span>
        <span class="product__price-was">$69.99</span>
        <span class="product__save">SAVE 50%</span>
      </div>

      <div class="product__select">
        <p class="product__label" style="margin-bottom:10px">Nation — <span data-swatch-label>Argentina</span></p>
        <div class="product__swatches" data-swatches role="radiogroup" aria-label="Nation">
          <button class="swatch is-active" data-swatch="Argentina" data-thumb-target="0" style="background:linear-gradient(180deg,#75AADB 50%,#fff 50%)" aria-checked="true"  aria-label="Argentina"></button>
          <button class="swatch"           data-swatch="France"      data-thumb-target="1"  style="background:linear-gradient(180deg,#002395 33%,#fff 33%,#fff 67%,#ED2939 67%)"        aria-checked="false" aria-label="France"></button>
          <button class="swatch"           data-swatch="Portugal"   data-thumb-target="2"  style="background:linear-gradient(90deg,#006600 40%,#C8102E 40%)"                            aria-checked="false" aria-label="Portugal"></button>
          <button class="swatch"           data-swatch="Brazil"     data-thumb-target="3"  style="background:linear-gradient(180deg,#009C3B 50%,#FEDF00 50%)"                           aria-checked="false" aria-label="Brazil"></button>
          <button class="swatch"           data-swatch="England"    data-thumb-target="4"  style="background:#fff;border-color:#CF142B"                                                 aria-checked="false" aria-label="England"></button>
          <button class="swatch"           data-swatch="Spain"      data-thumb-target="5"  style="background:linear-gradient(180deg,#AA151B 28%,#F1BF00 28%,#F1BF00 72%,#AA151B 72%)" aria-checked="false" aria-label="Spain"></button>
          <button class="swatch"           data-swatch="Germany"    data-thumb-target="6"  style="background:linear-gradient(180deg,#000 33%,#D00 33%,#D00 67%,#FFCE00 67%)"           aria-checked="false" aria-label="Germany"></button>
          <button class="swatch"           data-swatch="Uruguay"    data-thumb-target="7"  style="background:linear-gradient(180deg,#009FE3 50%,#fff 50%)"                              aria-checked="false" aria-label="Uruguay"></button>
          <button class="swatch"           data-swatch="Netherlands" data-thumb-target="8" style="background:linear-gradient(180deg,#AE1C28 33%,#fff 33%,#fff 67%,#21468B 67%)"        aria-checked="false" aria-label="Netherlands"></button>
          <button class="swatch"           data-swatch="Mexico"     data-thumb-target="9"  style="background:linear-gradient(180deg,#006847 33%,#fff 33%,#fff 67%,#CE1126 67%)"        aria-checked="false" aria-label="Mexico"></button>
          <button class="swatch"           data-swatch="USA"        data-thumb-target="10" style="background:linear-gradient(180deg,#002868 33%,#fff 33%,#fff 67%,#BF0A30 67%)"        aria-checked="false" aria-label="USA"></button>
          <button class="swatch"           data-swatch="Japan"      data-thumb-target="11" style="background:radial-gradient(circle at center,#BC002D 36%,#fff 36%)"                   aria-checked="false" aria-label="Japan"></button>
          <button class="swatch"           data-swatch="Morocco"    data-thumb-target="12" style="background:linear-gradient(135deg,#C1272D 75%,#006233 75%)"                           aria-checked="false" aria-label="Morocco"></button>
          <button class="swatch"           data-swatch="Colombia"   data-thumb-target="13" style="background:linear-gradient(180deg,#FCD116 50%,#003087 50%,#003087 75%,#CF142B 75%)"  aria-checked="false" aria-label="Colombia"></button>
          <button class="swatch"           data-swatch="Croatia"    data-thumb-target="14" style="background:linear-gradient(90deg,#C8102E 50%,#fff 50%)"                               aria-checked="false" aria-label="Croatia"></button>
          <button class="swatch"           data-swatch="Senegal"    data-thumb-target="15" style="background:linear-gradient(180deg,#00853F 33%,#FDEF42 33%,#FDEF42 67%,#E31B23 67%)" aria-checked="false" aria-label="Senegal"></button>
        </div>
      </div>

      <div class="product__select">
        <p class="product__label" style="margin-bottom:10px">Size — <span data-swatch-label>M</span></p>
        <div class="product__sizes" data-swatches role="radiogroup" aria-label="Size">
          <button class="size-opt" data-swatch="S" aria-checked="false">S</button>
          <button class="size-opt is-active" data-swatch="M" aria-checked="true">M</button>
          <button class="size-opt" data-swatch="L" aria-checked="false">L</button>
          <button class="size-opt" data-swatch="XL" aria-checked="false">XL</button>
          <button class="size-opt" data-swatch="XXL" aria-checked="false">XXL</button>
        </div>
      </div>

      <div class="product__buttons">
        <button class="btn btn--dark btn--block btn--lg" data-add-to-cart>Add to Cart</button>
        <a href="/checkout" class="btn btn--outline btn--block btn--lg">Buy Now</a>
      </div>

      <div class="product__trust">
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Free Worldwide Shipping
        </span>
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          30-Day Returns
        </span>
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
          Authentic Quality
        </span>
      </div>

      <div class="attach">
        <div class="attach__head">
          <span class="attach__title">Most-wanted nations</span>
          <span class="attach__note">All 32 available</span>
        </div>
        <div class="attach__grid attach__grid--nations">
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#74ACDF 50%,#fff 50%)"></span><span class="attach__lbl">Argentina</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#009C3B 50%,#FEDF00 50%)"></span><span class="attach__lbl">Brazil</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#002395 33%,#fff 33%,#fff 67%,#ED2939 67%)"></span><span class="attach__lbl">France</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(90deg,#006600 40%,#C8102E 40%)"></span><span class="attach__lbl">Portugal</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:#fff;border:2px solid #CF142B"></span><span class="attach__lbl">England</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#AA151B 28%,#F1BF00 28%,#F1BF00 72%,#AA151B 72%)"></span><span class="attach__lbl">Spain</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#000 33%,#D00 33%,#D00 67%,#FFCE00 67%)"></span><span class="attach__lbl">Germany</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#009FE3 50%,#fff 50%)"></span><span class="attach__lbl">Uruguay</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#AE1C28 33%,#fff 33%,#fff 67%,#21468B 67%)"></span><span class="attach__lbl">Netherlands</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#006847 33%,#fff 33%,#fff 67%,#CE1126 67%)"></span><span class="attach__lbl">Mexico</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#002868 33%,#fff 33%,#fff 67%,#BF0A30 67%)"></span><span class="attach__lbl">USA</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:radial-gradient(circle at center,#BC002D 36%,#fff 36%)"></span><span class="attach__lbl">Japan</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(135deg,#C1272D 75%,#006233 75%)"></span><span class="attach__lbl">Morocco</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#FCD116 50%,#003087 50%,#003087 75%,#CF142B 75%)"></span><span class="attach__lbl">Colombia</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(90deg,#C8102E 50%,#fff 50%)"></span><span class="attach__lbl">Croatia</span></div>
          <div class="attach__item"><span class="nation-dot" style="background:linear-gradient(180deg,#00853F 33%,#FDEF42 33%,#FDEF42 67%,#E31B23 67%)"></span><span class="attach__lbl">Senegal</span></div>
        </div>
      </div>

      <div class="accordion" data-accordion>
        {% for block in section.blocks %}
          <div class="accordion__item" data-accordion-item {{ block.shopify_attributes }}>
            <button class="accordion__trigger" data-accordion-trigger aria-expanded="false">
              {{ block.settings.title }}
              <span class="accordion__icon" aria-hidden="true"></span>
            </button>
            <div class="accordion__panel" data-accordion-panel>
              <div class="accordion__panel-inner">{{ block.settings.content }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Gallery photos — Assets files (easiest)" },
    { "type": "paragraph", "content": "Upload your photos via Edit code → Assets, then enter the exact filenames below (e.g. jersey-1.jpg)." },
    { "type": "text", "id": "file_1", "label": "File 1 — Argentina (main)", "default": "jersey-1.jpg" },
    { "type": "text", "id": "file_2", "label": "File 2 — France", "default": "jersey-2.jpg" },
    { "type": "text", "id": "file_3", "label": "File 3 — Portugal", "default": "jersey-3.jpg" },
    { "type": "text", "id": "file_4", "label": "File 4 — Brazil", "default": "jersey-4.jpg" },
    { "type": "text", "id": "file_5",  "label": "File 5 — England",     "default": "jersey-5.jpg" },
    { "type": "text", "id": "file_6",  "label": "File 6 — Spain",       "default": "jersey-6.jpg" },
    { "type": "text", "id": "file_7",  "label": "File 7 — Germany",     "default": "jersey-7.jpg" },
    { "type": "text", "id": "file_8",  "label": "File 8 — Uruguay",     "default": "jersey-8.jpg" },
    { "type": "text", "id": "file_9",  "label": "File 9 — Netherlands", "default": "jersey-9.jpg" },
    { "type": "text", "id": "file_10", "label": "File 10 — Mexico",     "default": "jersey-10.jpg" },
    { "type": "text", "id": "file_11", "label": "File 11 — USA",        "default": "jersey-11.jpg" },
    { "type": "text", "id": "file_12", "label": "File 12 — Japan",      "default": "jersey-12.jpg" },
    { "type": "text", "id": "file_13", "label": "File 13 — Morocco",    "default": "jersey-13.jpg" },
    { "type": "text", "id": "file_14", "label": "File 14 — Colombia",   "default": "jersey-14.jpg" },
    { "type": "text", "id": "file_15", "label": "File 15 — Croatia",    "default": "jersey-15.jpg" },
    { "type": "text", "id": "file_16", "label": "File 16 — Senegal",    "default": "jersey-16.jpg" },
    { "type": "header", "content": "Gallery photos — image picker (optional override)" },
    { "type": "image_picker", "id": "image_1",  "label": "Image 1 (main)" },
    { "type": "image_picker", "id": "image_2",  "label": "Image 2" },
    { "type": "image_picker", "id": "image_3",  "label": "Image 3" },
    { "type": "image_picker", "id": "image_4",  "label": "Image 4" },
    { "type": "image_picker", "id": "image_5",  "label": "Image 5" },
    { "type": "image_picker", "id": "image_6",  "label": "Image 6" },
    { "type": "image_picker", "id": "image_7",  "label": "Image 7" },
    { "type": "image_picker", "id": "image_8",  "label": "Image 8" },
    { "type": "image_picker", "id": "image_9",  "label": "Image 9" },
    { "type": "image_picker", "id": "image_10", "label": "Image 10" },
    { "type": "image_picker", "id": "image_11", "label": "Image 11" },
    { "type": "image_picker", "id": "image_12", "label": "Image 12" },
    { "type": "image_picker", "id": "image_13", "label": "Image 13" },
    { "type": "image_picker", "id": "image_14", "label": "Image 14" },
    { "type": "image_picker", "id": "image_15", "label": "Image 15" },
    { "type": "image_picker", "id": "image_16", "label": "Image 16" },
    { "type": "header", "content": "Slide captions" },
    { "type": "text", "id": "cap_1",  "label": "Caption 1",  "default": "Stadium-grade heavyweight knit" },
    { "type": "text", "id": "cap_2",  "label": "Caption 2",  "default": "Crisp heat-pressed badges" },
    { "type": "text", "id": "cap_3",  "label": "Caption 3",  "default": "Breathable quick-dry mesh" },
    { "type": "text", "id": "cap_4",  "label": "Caption 4",  "default": "Add your name & number free" },
    { "type": "text", "id": "cap_5",  "label": "Caption 5",  "default": "Classic three lions home kit" },
    { "type": "text", "id": "cap_6",  "label": "Caption 6",  "default": "La Roja official colors" },
    { "type": "text", "id": "cap_7",  "label": "Caption 7",  "default": "Die Mannschaft home kit" },
    { "type": "text", "id": "cap_8",  "label": "Caption 8",  "default": "La Celeste home kit" },
    { "type": "text", "id": "cap_9",  "label": "Caption 9",  "default": "Oranje away edition" },
    { "type": "text", "id": "cap_10", "label": "Caption 10", "default": "El Tri home colors" },
    { "type": "text", "id": "cap_11", "label": "Caption 11", "default": "Stars & Stripes home kit" },
    { "type": "text", "id": "cap_12", "label": "Caption 12", "default": "Samurai Blue home kit" },
    { "type": "text", "id": "cap_13", "label": "Caption 13", "default": "Atlas Lions home kit" },
    { "type": "text", "id": "cap_14", "label": "Caption 14", "default": "Los Cafeteros home kit" },
    { "type": "text", "id": "cap_15", "label": "Caption 15", "default": "Vatreni checkerboard kit" },
    { "type": "text", "id": "cap_16", "label": "Caption 16", "default": "Lions of Teranga home kit" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Sizing & fit", "content": "True to size with a standard athletic cut. S (chest 36\"), M (40\"), L (44\"), XL (48\"), XXL (52\"). Between sizes? Size up for a relaxed fan fit." } },
        { "type": "accordion", "settings": { "title": "Shipping & delivery", "content": "Free tracked worldwide shipping. Orders dispatch within 48 hours; delivery typically 7–12 business days depending on your country." } },
        { "type": "accordion", "settings": { "title": "Material & care", "content": "100% breathable quick-dry polyester knit with heat-pressed crests. Machine wash cold, inside out, and hang dry to keep colors vivid." } },
        { "type": "accordion", "settings": { "title": "Returns", "content": "Not the right fit? Return within 30 days for a free exchange or full refund. Personalized jerseys are final sale." } }
      ]
    }
  ]
}
{% endschema %}
