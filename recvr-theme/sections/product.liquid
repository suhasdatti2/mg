<section class="section product" id="product">
  <div class="wrap product__grid">
    <!-- Media gallery -->
    <div class="product__media reveal">
      <div class="product__main">
        {% render 'product-photo',
          image: section.settings.image_1,
          file: section.settings.file_1,
          id: 'ProdMain',
          class: 'product__main-img2',
          alt: 'RECVR Pro massage gun',
          loading: 'eager' %}
        {%- if section.settings.cap_1 != blank -%}
          <span class="product__caption" id="ProdCaption">{{ section.settings.cap_1 }}</span>
        {%- endif -%}
      </div>
      <div class="product__thumbs">
        {%- assign caps = section.settings.cap_1 | append: '|' | append: section.settings.cap_2 | append: '|' | append: section.settings.cap_3 | append: '|' | append: section.settings.cap_4 | split: '|' -%}
        {%- assign files = section.settings.file_1 | append: '|' | append: section.settings.file_2 | append: '|' | append: section.settings.file_3 | append: '|' | append: section.settings.file_4 | split: '|' -%}
        {%- for n in (1..4) -%}
          {%- assign key = 'image_' | append: n -%}
          {%- assign img = section.settings[key] -%}
          {%- assign cap = caps[forloop.index0] -%}
          {%- assign file = files[forloop.index0] -%}
          {%- if img != blank -%}{%- assign src = img | image_url: width: 1400 -%}{%- else -%}{%- assign src = file | asset_url -%}{%- endif -%}
          <button class="product__thumb {% if forloop.first %}is-active{% endif %}" data-thumb
            data-img="{{ src }}"
            data-cap="{{ cap | escape }}"
            aria-label="View {{ n }}">
            {% render 'product-photo', image: img, file: file, alt: cap %}
          </button>
        {%- endfor -%}
      </div>
    </div>

    <!-- Details -->
    <div class="product__details reveal">
      <p class="product__label">RECVR™</p>
      <h1 class="product__title">RECVR™ Pro Percussion Massage Gun</h1>

      <div class="product__rating">
        <span class="product__stars">★★★★★</span>
        <span class="product__rating-count">4.9 · 2,847 reviews</span>
      </div>

      <div class="product__price">
        <span class="product__price-now">$49.99</span>
        <span class="product__price-was">$89.99</span>
        <span class="product__save">SAVE 44%</span>
      </div>

      <div>
        <p class="product__label" style="margin-bottom:10px">Color — <span data-swatch-label>Stealth Grey</span></p>
        <div class="product__swatches" data-swatches role="radiogroup" aria-label="Color">
          <button class="swatch is-active" data-swatch="Stealth Grey" data-gun-1="#5A5F66" data-gun-2="#34383D" style="background:#4A4E54" aria-checked="true" aria-label="Stealth Grey"></button>
          <button class="swatch" data-swatch="Matte Silver" data-gun-1="#D2D5D9" data-gun-2="#A4A8AD" style="background:#C7CACE" aria-checked="false" aria-label="Matte Silver"></button>
          <button class="swatch" data-swatch="Midnight Blue" data-gun-1="#2A3F66" data-gun-2="#15233E" style="background:#1B2A4A" aria-checked="false" aria-label="Midnight Blue"></button>
          <button class="swatch" data-swatch="All Black" data-gun-1="#222222" data-gun-2="#0A0A0A" style="background:#0A0A0A" aria-checked="false" aria-label="All Black"></button>
        </div>
      </div>

      <div class="product__buttons">
        <button class="btn btn--dark btn--block btn--lg" data-add-to-cart>Add to Cart</button>
        <a href="/checkout" class="btn btn--lime btn--block btn--lg">Buy Now — $49.99</a>
      </div>

      <div class="product__trust">
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Free Shipping
        </span>
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          30-Day Returns
        </span>
        <span class="product__trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/></svg>
          1-Year Warranty
        </span>
      </div>

      <div class="attach">
        <div class="attach__head">
          <span class="attach__title">6 Pro attachment heads included</span>
          <span class="attach__note">Tool-free magnetic swap</span>
        </div>
        <div class="attach__grid">
          <div class="attach__item"><span class="attach__ic"><svg viewBox="0 0 40 40"><circle cx="20" cy="16" r="11"/><rect x="17" y="25" width="6" height="11" rx="3"/></svg></span><span class="attach__lbl">Ball</span></div>
          <div class="attach__item"><span class="attach__ic"><svg viewBox="0 0 40 40"><path d="M20 5c4 5 5 9 5 13s-2 7-5 7-5-3-5-7 1-8 5-13z"/><rect x="17" y="24" width="6" height="12" rx="3"/></svg></span><span class="attach__lbl">Bullet</span></div>
          <div class="attach__item"><span class="attach__ic"><svg viewBox="0 0 40 40"><rect x="9" y="7" width="7" height="16" rx="3.5"/><rect x="24" y="7" width="7" height="16" rx="3.5"/><rect x="17" y="22" width="6" height="13" rx="3"/></svg></span><span class="attach__lbl">Fork</span></div>
          <div class="attach__item"><span class="attach__ic"><svg viewBox="0 0 40 40"><rect x="8" y="11" width="24" height="9" rx="4.5"/><rect x="17" y="20" width="6" height="15" rx="3"/></svg></span><span class="attach__lbl">Flat</span></div>
          <div class="attach__item"><span class="attach__ic"><svg viewBox="0 0 40 40"><circle cx="20" cy="15" r="12"/><circle cx="20" cy="15" r="5" fill="none" stroke="currentColor" stroke-width="2"/><rect x="17" y="26" width="6" height="10" rx="3"/></svg></span><span class="attach__lbl">Cushion</span></div>
          <div class="attach__item"><span class="attach__ic"><svg viewBox="0 0 40 40"><path d="M14 8c6 0 12 4 12 9s-6 9-12 9z"/><rect x="11" y="24" width="6" height="12" rx="3"/></svg></span><span class="attach__lbl">Thumb</span></div>
        </div>
      </div>

      <div class="accordion" data-accordion>
        {% for block in section.blocks %}
          <div class="accordion__item" data-accordion-item {{ block.shopify_attributes }}>
            <button class="accordion__trigger" data-accordion-trigger aria-expanded="false">
              {{ block.settings.title }}
              <span class="accordion__icon" aria-hidden="true"></span>
            </button>
            <div class="accordion__panel" data-accordion-panel>
              <div class="accordion__panel-inner">{{ block.settings.content }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Gallery photos — Assets files (easiest)" },
    { "type": "paragraph", "content": "Upload your photos via Edit code → Assets, then enter the exact filenames below (e.g. product-1.jpg)." },
    { "type": "text", "id": "file_1", "label": "File 1 (main)", "default": "product-1.jpg" },
    { "type": "text", "id": "file_2", "label": "File 2", "default": "product-2.jpg" },
    { "type": "text", "id": "file_3", "label": "File 3", "default": "product-3.jpg" },
    { "type": "text", "id": "file_4", "label": "File 4 (attachments)", "default": "product-4.jpg" },
    { "type": "header", "content": "Gallery photos — image picker (optional override)" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (main)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4 (attachments)" },
    { "type": "header", "content": "Slide captions" },
    { "type": "text", "id": "cap_1", "label": "Caption 1", "default": "45dB near-silent brushless motor" },
    { "type": "text", "id": "cap_2", "label": "Caption 2", "default": "Tool-free magnetic attachments" },
    { "type": "text", "id": "cap_3", "label": "Caption 3", "default": "12mm deep-tissue amplitude" },
    { "type": "text", "id": "cap_4", "label": "Caption 4", "default": "6 pro heads for every muscle group" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "accordion", "settings": { "title": "What's in the box", "content": "RECVR™ Pro device, 6 attachment heads, USB-C charging cable, premium travel case, and a quick-start guide." } },
        { "type": "accordion", "settings": { "title": "Shipping time", "content": "Orders ship within 24 hours from our US warehouse. Free standard shipping arrives in 2–5 business days." } },
        { "type": "accordion", "settings": { "title": "How quiet is it", "content": "The brushless motor runs at around 45dB — about as loud as a quiet library. Use it anywhere without disturbing anyone." } },
        { "type": "accordion", "settings": { "title": "Return policy", "content": "Not feeling it? Return within 30 days for a full refund, no questions asked. Every order is backed by a 1-year warranty." } }
      ]
    }
  ]
}
{% endschema %}
