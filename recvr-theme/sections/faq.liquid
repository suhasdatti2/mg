<section class="section faq" id="faq">
  <div class="wrap faq__grid">
    <div class="faq__intro reveal">
      <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
      <h2 class="faq__title">{{ section.settings.headline }}</h2>
      <p class="faq__contact">Still curious? Email us at <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
    </div>
    <div class="faq__items reveal">
      <div class="accordion" data-accordion>
        {% for block in section.blocks %}
          <div class="accordion__item" data-accordion-item {{ block.shopify_attributes }}>
            <button class="accordion__trigger" data-accordion-trigger aria-expanded="false">
              {{ block.settings.question }}
              <span class="accordion__icon" aria-hidden="true"></span>
            </button>
            <div class="accordion__panel" data-accordion-panel>
              <div class="accordion__panel-inner">{{ block.settings.answer }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Everything you need to know" },
    { "type": "text", "id": "email", "label": "Contact email", "default": "hello@recvr.com" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Is it really only $49.99?", "answer": "Yes — for the duration of our flash sale. The RECVR™ Pro normally retails at $89.99. That's 44% off, today only." } },
        { "type": "faq", "settings": { "question": "Will it help with my back and neck pain?", "answer": "Percussion therapy increases blood flow and releases muscle tension, which many desk workers find relieves chronic back and neck tightness. It is a wellness device, not a medical treatment." } },
        { "type": "faq", "settings": { "question": "How long does the battery last?", "answer": "Up to 7 hours on a single charge, depending on intensity. It recharges via standard USB-C in about 90 minutes." } },
        { "type": "faq", "settings": { "question": "Is it loud?", "answer": "No. The brushless motor runs at roughly 45dB — quiet enough to use while watching TV or on a video call." } },
        { "type": "faq", "settings": { "question": "Which attachment head should I use?", "answer": "The ball head is great for large muscle groups, the bullet for pinpoint knots, the fork for the spine and neck, and the flat head for overall use. All six are included." } },
        { "type": "faq", "settings": { "question": "What if I don't like it?", "answer": "You're covered by our 30-day money-back guarantee and a full 1-year warranty. If it's not for you, send it back for a refund." } }
      ]
    }
  ]
}
{% endschema %}
