<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__content reveal">
      <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hero__title">{{ section.settings.headline }} <span class="accent">{{ section.settings.headline_accent }}</span></h1>
      <p class="hero__sub">{{ section.settings.subheadline }}</p>
      <div class="hero__ctas">
        <a href="#product" class="btn btn--lime btn--lg">{{ section.settings.cta_primary }}</a>
        <a href="#how-it-works" class="btn btn--ghost">{{ section.settings.cta_secondary }}</a>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <div class="hero__stat-num">32</div>
          <div class="hero__stat-label">Nations</div>
        </div>
        <div class="hero__stat">
          <div class="hero__stat-num">4.9★</div>
          <div class="hero__stat-label">Rating</div>
        </div>
        <div class="hero__stat">
          <div class="hero__stat-num">12K+</div>
          <div class="hero__stat-label">Orders Shipped</div>
        </div>
      </div>
    </div>

    <div class="hero__media reveal">
      <div class="hero__stage">
        {% render 'product-photo',
          image: section.settings.image,
          file: section.settings.image_file,
          class: 'hero__product float-soft',
          alt: 'Novora World Cup jersey',
          loading: 'eager' %}
      </div>
      <div class="hero__badge">Up to<br>50% Off</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "2026 World Cup Collection" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Wear your" },
    { "type": "text", "id": "headline_accent", "label": "Headline accent word", "default": "nation." },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Stadium-grade World Cup jerseys for every nation — breathable, true-to-fit, and ready to personalize with your name and number. Free worldwide shipping." },
    { "type": "text", "id": "cta_primary", "label": "Primary CTA", "default": "Shop Jerseys — $34.99" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary CTA", "default": "How it works" },
    { "type": "image_picker", "id": "image", "label": "Hero jersey image (optional)" },
    { "type": "text", "id": "image_file", "label": "…or Assets filename", "default": "jersey-1.jpg", "info": "Upload via Edit code → Assets, then put the exact filename here." }
  ]
}
{% endschema %}
